# Copy to .env and fill in. NEVER commit .env.
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://proconnect:change-me@postgres:5432/proconnect

# Safety switches — keep these for now:
DRY_RUN=true
OUTREACH_ENABLED=false
AUTO_REPLY_ENABLED=false

# Optional API keys (leave empty if unused)
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=
