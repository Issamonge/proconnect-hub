# ============================================
# AI VOICE AGENT - SETTINGS
# ============================================
# Copy this file to ".env" and fill in your values.
# I will help you get each of these.

# ============================================
# AI VOICE PLATFORM - BLAND AI
# ============================================
# Get your API key at https://bland.ai
# SECURITY: NEVER share your API key in chat or commit it to git.
# If you shared it before, REGENERATE it in the Bland dashboard now.
BLAND_AI_API_KEY=your_bland_api_key_here

# Optional: the phone number Bland assigns you (leave blank to use default)
BLAND_FROM_NUMBER=

# ============================================
# PAYMENT - how customers pay you
# ============================================
# The AI sends these payment options when a customer is ready to buy.
# Fill in the ones you want to accept.

# Crypto (BEP20 = BNB Smart Chain)
CRYPTO_USDT_ADDRESS=
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_NETWORK=BEP20

# PayPal (your PayPal email or paypal.me link)
PAYPAL_EMAIL=
PAYPAL_LINK=

# Stripe (create a payment link at https://dashboard.stripe.com/payment-links)
STRIPE_PAYMENT_LINK=

# Gumroad (for digital products)
GUMROAD_LINK=

# ============================================
# YOUR BUSINESS INFO - tell me these and I'll fill them in
# ============================================
BUSINESS_NAME=Your Business Name
BUSINESS_PHONE=your_phone_number
BUSINESS_EMAIL=your_email
YOUR_CALENDAR_LINK=https://calendly.com/your-link

# What you sell (the AI uses this to answer customer questions)
PRODUCT_NAME=
PRODUCT_PRICE=
PRODUCT_DESCRIPTION=

# ============================================
# LEAD SEARCH - who to find and where
# ============================================
# What type of business to find (plumber, dentist, restaurant, lawyer, etc.)
LEAD_SEARCH_NICHE=plumber
# Where to find them (city, state or country)
LEAD_SEARCH_LOCATION=Chicago, IL
# How many leads to find per search (max)
LEAD_SEARCH_LIMIT=50
# How long to wait between calls (seconds) - avoid being flagged as spam
CALL_INTERVAL_SECONDS=60

# Optional: Google Places API key for better local search
# Get it at https://console.cloud.google.com (enable Places API)
GOOGLE_PLACES_API_KEY=

# ============================================
# PAYMENT LINKS - for closing simple deals
# ============================================
# The AI sends these when a customer is ready to buy.
# Create at: https://dashboard.stripe.com/payment-links
STRIPE_PAYMENT_LINK=
# Or use PayPal: https://paypal.me/yourname
PAYPAL_LINK=
# Or Gumroad for digital products: https://yourname.gumroad.com
GUMROAD_LINK=

# Where to notify YOU when a lead comes in
# I can send you a Telegram message, email, or SMS
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
